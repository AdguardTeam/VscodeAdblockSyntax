            name: string.unquoted.adblock
          "4":
            name: punctuation.definition.adblock
      - name: invalid.illegal.app-list
        match: ".*"

  dnsClientsPipeSeparated:
    patterns:
      - match: "((~?)([^|]+)(\\|?))"
        captures:
          "2":
            name: keyword.other.adblock
          "3":
            name: string.unquoted.adblock
          "4":
            name: punctuation.definition.adblock
      - name: invalid.illegal.app-list
        match: ".*"
