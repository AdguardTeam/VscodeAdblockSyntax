# TMLanguage for Adblock Filter Lists
#
# This file makes possible the syntax highlighting of Adblock Filter Lists by tokenizing the rules
# and assigning a scope to each token.
#
# GitHub Linguist can use this file directly, but during the build, we convert it to a .plist file,
# so the VSCode extension can use it. Development is done in this .yaml-tmlanguage file.
#
# IMPORTANT: Colors are defined in your editor's color scheme, not here. This file only splits the
# filter list into tokens and assigns a scope to each token. After that, your editor will colorize
# the tokens according to the color scheme you have chosen. For more information, please visit:
# https://code.visualstudio.com/api/language-extensions/semantic-highlight-guide
#
# If you aren't familiar with TextMate Language Grammars, you can read the following documentations:
# - https://macromates.com/manual/en/language_grammars
# - https://www.sublimetext.com/docs/3/syntax.html
# - https://code.visualstudio.com/api/language-extensions/syntax-highlight-guide
---
name: Adblock
scopeName: text.adblock

patterns:
  - include: "#adblockAgent"
  - include: "#preprocessor"
  - include: "#comments"
  - include: "#snippetRulesABP"
  - include: "#cssRules"
  - include: "#scriptletRules"
  - include: "#scriptletRulesUBO"
  - include: "#jsRules"
  - include: "#contentRules"
  - include: "#elemhideRules"
  - include: "#basicRulesNoUrl"
  - include: "#basicRulesRegex"
  - include: "#basicRules"

repository:
  adblockAgent:
    patterns:
      - match: "^(\\[)([^\\]]+)(\\])\\s*$"
        name: meta.comment.adblock
        captures:
          "1":
            name: punctuation.definition.array.start.adblock.agent
          "2":
            patterns:
              - include: "#adblockData"
              - match: ";"
                name: punctuation.separator
              - name: invalid.illegal
                match: ".*"
          "3":
            name: punctuation.definition.array.end.adblock.agent

  adblockData:
    patterns:
      - match: |-
          (?x)
            (?:\s*)
            (
                [Aa]d[Bb]lock(?:\s[Pp]lus)?
                |u[Bb]lock(?:\s[Oo]rigin)?
                |[Aa]d[Gg]uard
            )
            (?:\s+(\d+(?:\.\d+)*+\+?))?
            (?:\s*)
        captures:
          "1":
            name: constant.language.agent.adblocker.name
          "2":
            name: constant.numeric.decimal

  preprocessor:
    patterns:
      - match: "^(!#if)(\\s)(.*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.directive
          "2":
            name: keyword.other.delimiter.whitespace
          "3":
            patterns:
              # variable names
              - name: constant.language.platform.name
                match: "[A-Za-z]+[\\w_-]*"
              # and (&&) operator
              - name: keyword.operator.logical.and
                match: "&&"
              # or (||) operator
              - name: keyword.operator.logical.or
                match: "\\|\\|"
              # not (!) operator
              - name: keyword.operator.logical.not
                match: "!"
              # open and close parentheses
              - name: keyword.control.characters.parenthesis.open
                match: "\\("
              - name: keyword.control.characters.parenthesis.close
                match: "\\)"
              # space, tab
              - name: keyword.other.delimiter.whitespace
                match: "\\s+"
              # anything else is invalid
              - name: invalid.illegal
                match: ".*"
      - match: "^(!#include) (.*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.directive
          "2":
            name: string.unquoted
      # TODO: handle leading and trailing whitespace in the beginning, and not for every rule type
      - match: "^(!#else)(\\s*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.directive
          "2":
            name: keyword.other.delimiter.whitespace
      - match: "^(!#endif)(\\s*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.directive
          "2":
            name: keyword.other.delimiter.whitespace
      - match: "^(!#safari_cb_affinity)(.*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.directive
          "2":
            patterns:
              - name: constant.language.contentblocker.name
                match: "(all|general|privacy|social|security|other|custom|advanced)"
              - name: keyword.control.characters
                match: "(\\(|\\)|,)"
              - name: invalid.illegal
                match: ".*"
      - match: "^(!\\+) (.*)$"
        name: meta.comment.adblock
        captures:
          "1":
            name: keyword.preprocessor.hint
          "2":
            patterns:
              - name: keyword.control.hint.name
                match: "(NOT_OPTIMIZED|OPTIMIZED|PLATFORM|NOT_PLATFORM|NOT_VALIDATE)"
              - name: constant.language.platform.name
                # The basic regexp is greedy and stops once it finds a match, so 'ext_chromium_mv3' should be before 'ext_chromium'
                match: "(windows|mac|cli|android|ios|ext_chromium_mv3|ext_chromium|ext_ff|ext_edge|ext_opera|ext_ublock|ext_safari|ext_android_cb)"
              - name: keyword.control.characters
                match: "(\\(|\\)|,)"
      - match: "^!#(?!#).+$"
        name: meta.comment.adblock invalid.illegal.preprocessor

  comments:
    patterns:
      - name: meta.comment.adblock comment.line.exclamation-sign
        match: "^!.*"
      - name: meta.comment.adblock comment.line.hashtag-sign
        # It's important to distinguish between hashmark based comments and general cosmetic rules, so we need to
        # exclude valid cosmetic rule separators from the match. This way, for example ##.foo will not be incorrectly
        # marked as a comment.
        # TODO: If a new cosmetic rule separator is added, it should be added here too
        match: "^#(?!(?:@?(?:\\$?\\?|\\$|%)?#)).*"

  elemhideRules:
    patterns:
      # Element hiding rules. The optional '@' inside the separator (e.g. '#@#',
      # '#@?#') is captured separately and scoped as the exception marker.
      # The domain group is pinned to the first '#' so a '#@#' substring inside
      # the selector cannot be mistaken for the separator.
      - match: |-
          (?x)
            ^                                                # Start of the line
            (                                                # Group 1. Cosmetic rule options (optional)
              \[                                             #   Opening bracket
                (?:                                          #   One or more of:
                  \/(?:\\.|[^\/\\])*\/[a-z]*                 #     Regex pattern (handles ] inside regex like /[class]/)
                  |[^\]]                                     #     OR any character except closing bracket
                )+
              \]                                             #   Closing bracket
            )?
            ([^#]*?)                                         # Group 2. Domain list
            (\#(@?)\??\#\^?)                                 # Group 3. Separator (Group 4. optional exception marker)
            (.+)                                             # Group 5. CSS selector
            $                                                # End of the line
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: meta.exception.adblock
          "5":
            patterns:
              - include: "#cssSelector"

  snippetRulesABP:
    patterns:
      # ABP snippet rules. The optional '@' in the separator ('#$#' / '#@$#')
      # is captured separately and scoped as the exception marker.
      - match: "^([^#]*?)(#(@?)\\$#)([^{]+)$"
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#domainListCommaSeparated"
          "2":
            name: keyword.control.adblock
          "3":
            name: meta.exception.adblock
          "4":
            name: constant.character.snippet.adblock

  cssRules:
    patterns:
      # CSS injection rules. The optional '@' in the separator ('#$#' / '#$?#' /
      # '#@$#' / '#@$?#') is captured separately and scoped as the exception marker.
      - match: "^(\\[.+?\\])?([^#]*?)(#(@?)\\$\\??#)(.+)$"
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: meta.exception.adblock
          "5":
            patterns:
              - include: "#cssStyle"

  contentRules:
    patterns:
      # HTML filtering rules. The optional '@' in the marker ('$$' / '$@$') is
      # captured separately and scoped as the exception marker. The domain group
      # is pinned to the first '$' so a '$@$' substring inside the selector
      # cannot be mistaken for the marker.
      - match: |-
          (?x)
            ^                                                # Start of the line
            (                                                # Group 1. Cosmetic rule options (optional)
              \[                                             #   Opening bracket
                (?:                                          #   One or more of:
                  \/(?:\\.|[^\/\\])*\/[a-z]*                 #     Regex pattern (handles ] inside regex like /[class]/)
                  |[^\]]                                     #     OR any character except closing bracket
                )+
              \]                                             #   Closing bracket
            )?
            ([^$]*?)                                         # Group 2. Domain list
            (\$(@?)\$)                                       # Group 3. Marker (Group 4. optional exception marker)
            (.+)                                             # Group 5. CSS selector
            $                                                # End of the line
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: meta.exception.adblock
          "5":
            patterns:
              - include: "#htmlFilteringCssSelector"

  scriptletRules:
    patterns:
      - include: "#exceptionScriptletRules"
      - include: "#blockingScriptletRules"

  exceptionScriptletRules:
    patterns:
      - match: |-
          (?x)
            ^                                                # Start of the line
            (                                                # Group 1. Cosmetic rule options (optional)
              \[                                             #   Opening bracket
                (?:                                          #   One or more of:
                  \/(?:\\.|[^\/\\])*\/[a-z]*                 #     Regex pattern (handles ] inside regex like /[class]/)
                  |[^\]]                                     #     OR any character except closing bracket
                )+
              \]                                             #   Closing bracket
            )?
            (.*?)                                            # Group 2. Domain list
            (\#(@)%\#)                                       # Group 3. Marker (Group 4. exception marker)
            (\/\/scriptlet)                                  # Group 5. Scriptlet marker
            (\()                                             # Group 6. Opening parenthesis
            (.*)?                                            # Group 7. Arguments
            (\))                                             # Group 8. Closing parenthesis
            \s*                                              # Optional trailing whitespace
            $                                                # End of the line
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: meta.exception.adblock
          "5":
            name: entity.name.function.adblock
          "6":
            name: punctuation.section.adblock
          "7":
            patterns:
              - include: "#emptyScriptletFunction"
              - include: "#scriptletFunction"
          "8":
            name: punctuation.section.adblock

  blockingScriptletRules:
    patterns:
      - match: |-
          (?x)
            ^                                                # Start of the line
            (                                                # Group 1. Cosmetic rule options (optional)
              \[                                             #   Opening bracket
                (?:                                          #   One or more of:
                  \/(?:\\.|[^\/\\])*\/[a-z]*                 #     Regex pattern (handles ] inside regex like /[class]/)
                  |[^\]]                                     #     OR any character except closing bracket
                )+
              \]                                             #   Closing bracket
            )?
            (.*?)                                            # Group 2. Domain list
            (\#%\#)                                          # Group 3. Cosmetic rule marker
            (\/\/scriptlet)                                  # Group 4. Scriptlet marker
            (\()                                             # Group 5. Opening parenthesis
            (.*\S.*)                                         # Group 6. Arguments. Note: we look for a parameter that contain at least one non-whitespace character
            (\))                                             # Group 7. Closing parenthesis
            \s*                                              # Optional trailing whitespace
            $                                                # End of the line
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: entity.name.function.adblock
          "5":
            name: punctuation.section.adblock
          "6":
            patterns:
              - include: "#scriptletFunction"
          "7":
            name: punctuation.section.adblock

  scriptletRulesUBO:
    patterns:
      # uBO scriptlet rules. The optional '@' in the separator ('##' / '#@#') is
      # captured separately and scoped as the exception marker.
      - match: "^([^#]*?)(#(@?)#)(\\+js)(\\()(.+)(\\)\\s*)$"
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#domainListCommaSeparated"
          "2":
            name: keyword.control.adblock
          "3":
            name: meta.exception.adblock
          "4":
            name: entity.name.function.adblock
          "5":
            name: punctuation.section.adblock
          "6":
            patterns:
              - include: "#scriptletFunctionUBO"
          "7":
            name: punctuation.section.adblock

  jsRules:
    # In this case, we embed the JS grammar in the adblock grammar
    # by using the include: "source.js" scope.
    # This is an external grammar, so it should be installed separately,
    # but both VSCode and GitHub Linguist will recognize it.
    # See https://github.com/github-linguist/linguist/discussions/6020#discussioncomment-3397226
    patterns:
      # Do not confuse with #%#//scriptlet, so we use a negative lookahead
      # to make sure the separator is not followed by //scriptlet.
      # JS injection rules (separator '#%#' / '#@%#'). The optional '@' in the
      # separator is captured separately and scoped as the exception marker.
      # The domain group is pinned to the first '#' so a '#@%#' substring later
      # in the JS body cannot be mistaken for the separator.
      - begin: ^(\[(?:\/(?:\\.|[^\/\\])*\/[a-z]*|[^\]])+\])?([^#]*?)(#(@?)%#(?!\/\/scriptlet))
        beginCaptures:
          "1":
            patterns:
              - include: "#cosmeticRulesOptions"
          "2":
            patterns:
              - include: "#domainListCommaSeparated"
          "3":
            name: keyword.control.adblock
          "4":
            name: meta.exception.adblock
        end: "$"
        name: meta.cosmetic.adblock
        contentName: source.js
        patterns:
          - include: source.js
      # Mark any other JS inject as invalid, typically unclosed / invalid
      # scriptlet calls (separator '#%#' / '#@%#').
      - match: "^([^#]*?)(#(@?)%#)(.+)$"
        name: meta.cosmetic.adblock
        captures:
          "1":
            patterns:
              - include: "#domainListCommaSeparated"
          "2":
            name: keyword.control.adblock
          "3":
            name: meta.exception.adblock
          "4":
            name: invalid.illegal

  basicRulesNoUrl:
    patterns:
      - match: "^(\\$)(.+)$"
        name: meta.network.adblock
        captures:
          "1":
            name: keyword.control.adblock
          "2":
            patterns:
              - include: "#modifierList"

  basicRulesRegex:
    patterns:
      - match: "^(\\/[^\\/\\\\]*(?:\\\\.[^\\/\\\\]*)*\\/[dgimsuy]*)(?:(\\$)(.+))?$"
        name: meta.network.adblock
        captures:
          "1":
            patterns:
              - include: "#regularExpression"
          "2":
            name: keyword.control.adblock
          "3":
            patterns:
              - include: "#modifierList"

  basicRules:
    patterns:
      # Exception (allowlist) network rules: the line begins with '@@'. The
      # '@@' is consumed by Group 1 (urlPattern) exactly as in the blocking
      # variant, so token boundaries and leaf scopes are unchanged.
      - match: |-
          (?x)
            ^
            (?=@@)                                # Exception marker: line starts with @@
            # Group 1. URL pattern (note: ? is used to make it non-greedy)
            (.*?)
            (?:
              # Group 2. Network rule separator
              (\$)(?=\s*~?\s*[\w-]+\s*(?:[=,]|$))
              # Group 3. Network rule modifiers
              (.*)
            )?
            $
        name: meta.network.adblock meta.exception.adblock
        captures:
          "1":
            patterns:
              - include: "#urlPattern"
          "2":
            name: keyword.control.adblock
          "3":
            patterns:
              - include: "#modifierList"
      - match: |-
          (?x)
            ^
            (?=\s*\S)                             # Skip blank / whitespace-only lines (kept uncategorized)
            # Group 1. URL pattern (note: ? is used to make it non-greedy)
            (.*?)
            (?:
              # Group 2. Network rule separator
              (\$)(?=\s*~?\s*[\w-]+\s*(?:[=,]|$))
              # Group 3. Network rule modifiers
              (.*)
            )?
            $
        name: meta.network.adblock
        captures:
          "1":
            patterns:
              - include: "#urlPattern"
          "2":
            name: keyword.control.adblock
          "3":
            patterns:
              - include: "#modifierList"

  regularExpression:
    patterns:
      - begin: "(/)"
        beginCaptures:
          "1":
            name: punctuation.definition.string.begin.regexp.adblock
        end: "((?<!\\\\)/)([dgimsuy]*)?"
        endCaptures:
          "1":
            name: punctuation.definition.string.end.regexp.adblock
          "2":
            name: keyword.other.regexp.adblock
        contentName: string.regexp.adblock
        patterns:
          - include: "#regexp"

  regexp:
    patterns:
      # Character classes
      - name: constant.other.character-class.set.regexp
        match: "\\\\[wWsSdDpP]"
      - name: constant.character.escape.regexp
        match: "\\\\[bBnrtfv0]"
      - name: constant.character.escape.regexp
        match: "\\\\x[0-9A-Fa-f]{2}"
      - name: constant.character.escape.regexp
        match: "\\\\u[0-9A-Fa-f]{4}"
      - name: constant.character.escape.regexp
        match: "\\\\."

      # Character class brackets
      - begin: "(\\[)(\\^)?"
        beginCaptures:
          "1":
            name: punctuation.definition.character-class.regexp
          "2":
            name: keyword.operator.negation.regexp
        end: "(\\])"
        endCaptures:
          "1":
            name: punctuation.definition.character-class.regexp
        name: constant.other.character-class.regexp
        patterns:
          - match: "\\\\[\\]\\-\\\\]"
            name: constant.character.escape.regexp
          - match: "[^\\]]"

      # Groups and captures
      - begin: "(\\()(\\?[:=!<]|\\?<[=!]|\\?P?<[^>]+>)?"
        beginCaptures:
          "1":
            name: punctuation.definition.group.regexp
          "2":
            name: punctuation.definition.group.assertion.regexp
        end: "(\\))"
        endCaptures:
          "1":
            name: punctuation.definition.group.regexp
        patterns:
          - include: "#regexp"

      # Alternation
      - name: keyword.operator.or.regexp
        match: "\\|"

      # Quantifiers
      - name: keyword.operator.quantifier.regexp
        match: "[*+?]\\??"
      - name: keyword.operator.quantifier.regexp
        match: "\\{\\d+(,\\d*)?\\}\\??"

      # Anchors and boundaries
      - name: keyword.control.anchor.regexp
        match: "\\^|\\$"
      - name: keyword.control.anchor.regexp
        match: "\\\\[bB]"

      # Backreferences
      - name: keyword.other.back-reference.regexp
        match: "\\\\[1-9]\\d*"

  headerValue:
    patterns:
      # Header name with regex value: name:/pattern/flags or name:~/pattern/flags
      - match: ([\w-]+)(:)(~?)(/.+?(?<!\\)/[a-z]*)
        captures:
          "1":
            name: entity.name.tag.adblock
          "2":
            name: punctuation.separator.key-value.adblock
          "3":
            name: keyword.operator.logical.adblock
          "4":
            patterns:
              - match: (/)(.+?(?<!\\))(/)([a-z]*)
                captures:
                  "1":
                    name: punctuation.definition.string.begin.regexp.adblock
                  "2":
                    name: string.regexp.adblock
                  "3":
                    name: punctuation.definition.string.end.regexp.adblock
                  "4":
                    name: keyword.other.regexp.adblock
      # Header name with literal value: name:value or name:~value
      - match: ([\w-]+)(:)(~?)([^/]+)
        captures:
          "1":
            name: entity.name.tag.adblock
          "2":
            name: punctuation.separator.key-value.adblock
          "3":
            name: keyword.operator.logical.adblock
          "4":
            name: string.unquoted.adblock
      # Just header name: name
      - match: ([\w-]+)
        captures:
          "1":
            name: entity.name.tag.adblock

  urlskipValue:
    patterns:
      # Regex directive in urlskip value
      - include: "#regularExpression"
      # Everything else as unquoted string
      - match: ".+"
        name: string.unquoted.adblock

  replaceValue:
    patterns:
      - begin: "(/)"
        beginCaptures:
          "1":
            name: keyword.operator.adblock
        end: "((?<!\\\\)/)([igmsuy]*)?"
        endCaptures:
          "1":
            name: keyword.operator.adblock
          "2":
            name: keyword.other.adblock
        patterns:
          # Regexp part (before middle slash)
          - begin: "\\G"
            end: "((?<!\\\\)/)"
            endCaptures:
              "1":
                name: keyword.operator.adblock
            contentName: string.regexp.adblock
            patterns:
              - include: "#regexp"
          # Replacement part (after middle slash)
          - begin: "(?=.)"
            end: "(?=(?<!\\\\)/)"
            contentName: string.unquoted.adblock
            patterns:
              - include: "#replaceReplacement"

  replaceReplacement:
    patterns:
      # Escaped characters (including \$)
      - match: '\\.'
        name: constant.character.escape.adblock
      # Number after escaped dollar (for $1, $2 etc.)
      - match: '\d+'
        name: keyword.other.adblock

  urlPattern:
    patterns:
      - name: string.regexp.adblock
        match: "^(@@)?((\\/)(.+)\\/$)"
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            patterns:
              - include: "#regularExpression"
      - match: "^@@\\|?\\|?"
        name: keyword.other.adblock
      - match: "^\\|\\|"
        name: keyword.other.adblock
      - match: "^\\|"
        name: keyword.other.adblock
      - match: "\\|$"
        name: keyword.other.adblock
      - match: "\\^"
        name: keyword.other.adblock
      - match: "\\*"
        name: keyword.other.adblock

  modifierList:
    patterns:
      # Special case for header modifier with regex value
      # https://github.com/gorhill/uBlock/wiki/Static-filter-syntax#header
      - match: |-
          (?x)
            (~?\s*header)                         # Group 1. header modifier name
            \s*                                   #   Optional whitespace before =
            (=)                                   #   Group 2. Assignment operator
            \s*                                   #   Optional whitespace after =
            ([\w-]+)                              #   Group 3. Header name
            (:)                                   #   Group 4. Colon
            (~?)                                  #   Group 5. Optional negation
            (/)                                   #   Group 6. Opening slash
            (.+?)                                 #   Group 7. Regex content
            (?<!\\)(/)                            #   Group 8. Closing slash (not escaped)
            ([a-z]*)                              #   Group 9. Flags
            (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)  #   End: unescaped comma followed by modifier, or end
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
          "3":
            name: entity.name.tag.adblock
          "4":
            name: punctuation.separator.key-value.adblock
          "5":
            name: keyword.operator.logical.adblock
          "6":
            name: punctuation.definition.string.begin.regexp.adblock
          "7":
            patterns:
              - include: "#regexp"
              - match: .+
                name: string.regexp.adblock
          "8":
            name: punctuation.definition.string.end.regexp.adblock
          "9":
            name: keyword.other.regexp.adblock
          "10":
            name: keyword.operator.adblock

      # Special case for header modifier with literal value or no value
      - match: |-
          (?x)
            (~?\s*header)                         # Group 1. header modifier name
            \s*                                   #   Optional whitespace before =
            (=)                                   #   Group 2. Assignment operator
            \s*                                   #   Optional whitespace after =
            ([\w-]+)                              #   Group 3. Header name
            (?:
              (:)                                 #   Group 4. Colon (optional)
              (~?)                                #   Group 5. Optional negation
              ([^,/]+)                            #   Group 6. Literal value (not starting with /)
            )?
            (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)  #   End: unescaped comma followed by modifier, or end
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
          "3":
            name: entity.name.tag.adblock
          "4":
            name: punctuation.separator.key-value.adblock
          "5":
            name: keyword.operator.logical.adblock
          "6":
            name: string.unquoted.adblock
          "7":
            name: keyword.operator.adblock

      # Special case for domain-like modifiers (domain, to, from, app, denyallow)
      # These accept: ["~"] entry_0 ["|" ["~"] entry_1 ["|" ["~"]entry_2 ...]]
      # where entry_i = ( item / regexp )
      # ~ and | are operators, simple values are strings, /.../ is regexp
      - begin: |-
          (?x)
            (~?\s*(?:domain|to|from|app|denyallow))   # Group 1. Modifier name
            \s*                                       #   Optional whitespace before =
            (=)                                       #   Group 2. Assignment operator
            \s*                                       #   Optional whitespace after =
        beginCaptures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
        end: (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)
        endCaptures:
          "1":
            name: keyword.operator.adblock
        patterns:
          # Negation operator
          - match: "~"
            name: keyword.operator.logical.adblock
          # Pipe separator
          - match: "\\|"
            name: keyword.operator.adblock
          # Regex value: /pattern/ (allowing unescaped pipes inside)
          - begin: "/"
            beginCaptures:
              "0":
                name: punctuation.definition.string.begin.regexp.adblock
            end: (?<!\\)/
            endCaptures:
              "0":
                name: punctuation.definition.string.end.regexp.adblock
            contentName: string.regexp.adblock
            patterns:
              - include: "#regexp"
              - match: '[^/\\]+'
                name: string.regexp.adblock
              - match: '\\.'
                name: string.regexp.adblock
          # Simple domain/value (not starting with / or special chars)
          - match: "[^~|/,\\s]+"
            name: string.unquoted.adblock

      # Special case for replace / urltransform modifier (uses /regexp/replacement/modifiers syntax)
      # https://adguard.com/kb/general/ad-filtering/create-own-filters/#replace-modifier
      # https://adguard.com/kb/general/ad-filtering/create-own-filters/#urltransform-modifier
      - match: |-
          (?x)
            (~?\s*(?:replace|urltransform))       # Group 1. replace modifier name
            \s*                                   #   Optional whitespace before =
            (=)                                   #   Group 2. Assignment operator
            \s*                                   #   Optional whitespace after =
            (                                     #   Group 3. replace value (/regexp/replacement/modifiers)
              (\/)                                #     Group 4. Opening slash
              (?:[^\/\\]|\\.)*                    #     Regexp part (escaped chars allowed)
              (\/)                                #     Group 5. Middle slash
              (?:[^\/\\]|\\.)*                    #     Replacement part (escaped chars allowed)
              (\/)                                #     Group 6. Closing slash
              ([a-z]*)                            #     Group 7. Optional modifiers (e.g., i)
            )
            (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)  #   End: unescaped comma followed by modifier, or end
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
          "3":
            patterns:
              - include: "#replaceValue"
            # name: string.unquoted.adblock
          "4":
            name: keyword.operator.adblock

      # Special case for urlskip modifier (allows regex with commas and multiple directives)
      # https://github.com/gorhill/uBlock/wiki/Static-filter-syntax#urlskip
      - match: |-
          (?x)
            (~?\s*urlskip)                        # Group 1. urlskip modifier name
            \s*                                   #   Optional whitespace before =
            (=)                                   #   Group 2. Assignment operator
            \s*                                   #   Optional whitespace after =
            (                                     #   Group 3. urlskip value (space-separated directives)
              (?:
                \/(?:[^\/\\]|\\.)+\/              #     Regex directive: /pattern/
                |\?[\w-]+                         #     Parameter extraction: ?name
                |&\d+                             #     Position extraction: &1
                |\#                               #     Hash extraction: #
                |\+https:?                        #     Protocol prepend: +https or +https:
                |-(?:
                  base64
                  |safebase64
                  |uricomponent
                  |blocked
                )                                 # Transformation directives
                |\s+                              #     Whitespace between directives
              )+?
            )
            (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)  #   End: unescaped comma followed by modifier, or end
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
          "3":
            patterns:
              - include: "#urlskipValue"
          "4":
            name: keyword.operator.adblock

      # General pattern for other modifiers
      - match: |-
          (?x)
            (~?\s*[\w-]+)                                      # Group 1. Modifier name
            (?:                                                # Optional value assignment
              \s*                                              #   Optional whitespace before =
              (=)                                              #   Group 2. Assignment operator
              \s*                                              #   Optional whitespace after =
              (?:                                              #   Value (one of three types)
                ('(?:[^'\\]|\\.)*')                            #     Group 3. Quoted string (single quotes)
                |(                                             #     Group 4. Regex (e.g., /pattern/flags or /pattern/replacement/flags)
                  \/                                           #       Opening slash
                  (?:[^\/\\]|\\.)+                             #       Pattern body (anything except unescaped /)
                  \/                                           #       Closing slash
                  (?:                                          #       Optional replacement part
                    (?:[^\/\\]|\\.)+                           #         Replacement body (anything except unescaped /)
                    \/                                         #         Closing slash
                  )?
                  [a-z]*                                       #       Optional flags (e.g., i, g, m)
                )
                |((?:\\.|[^,\\]|,(?!\s*~?\s*[\w-]))+?)         #     Group 5. Unquoted list (allows escaped commas with \,)
              )
            )?
            (?:\s*(?<!\\)(,)\s*(?=~?\s*[\w-])|$)               # End of modifier: unescaped comma followed by another modifier, or end of string
        captures:
          "1":
            name: keyword.other.adblock
          "2":
            name: keyword.operator.adblock
          "3":
            name: string.quoted.adblock
          "4":
            patterns:
              - include: "#regularExpression"
          "5":
            name: string.unquoted.adblock
          "6":
            name: keyword.operator.adblock
      - name: invalid.illegal.adblock
        match: ".*"

  cosmeticRulesOptions:
    match: |-
      (?x)
        (\[)     # Group 1. Opening bracket
          \s*    #   Optional whitespace
          (\$)   #   Group 2. Modifier separator
          \s*    #   Optional whitespace
          (.*)   #   Group 3. Modifier list
          \s*    #   Optional whitespace
        (\])     # Group 4. Closing bracket
    captures:
      "1":
        name: keyword.control.adblock
      "2":
        name: keyword.control.adblock
      "3":
        patterns:
          - include: "#modifierList"
      "4":
        name: keyword.control.adblock

  emptyScriptletFunction:
    patterns:
      - match: \s*\z
        name: entity.name.section.adblock.empty-scriptlet

  scriptletFunction:
    patterns:
      - match: ((['|"])(.*?)(?<!\\)(\2))(,\s*)?
        captures:
          "1":
            name: string.quoted.adblock
          "5":
            name: keyword.operator.adblock
      - name: invalid.illegal.adblock
        match: ".*"

  scriptletFunctionUBO:
    patterns:
      - match: "((?:[^\\\\,]+|\\\\.?)*)(,|$)"
        captures:
          "1":
            name: string.quoted.adblock
          "2":
            name: keyword.operator.adblock
      - name: invalid.illegal.adblock
        match: ".*"

  cssStyle:
    patterns:
      - match: "(@media[\\s]+[^\\{]*)(\\{)([\\s]*[^\\{]*)(\\{)([\\s]*[^\\}]*)(\\})[\\s]*(\\})"
        captures:
          "1":
            name: entity.name.function.adblock
          "2":
            name: punctuation.section.adblock
          "3":
            name: entity.name.function.adblock
          "4":
            name: punctuation.section.adblock
          "5":
            name: string.quoted.adblock
          "6":
            name: punctuation.section.adblock
          "7":
            name: punctuation.section.adblock
      - match: "([^{}]+)\\s*((\\{)(.+?)(\\}))"
        captures:
          "1":
            name: entity.name.function.adblock
          "3":
            name: punctuation.section.adblock
          "4":
            name: string.quoted.adblock
          "5":
            name: punctuation.section.adblock
      - name: invalid.illegal.adblock
        match: ".*"

  cssSelector:
    patterns:
      - name: entity.name.function.adblock
        match: ".+"

  htmlFilteringCssSelector:
    patterns:
      # ID selector
      - match: |-
          (?x)
            (\#)                      # Group 1: Prefix (#)
            -?                        # Optional leading hyphen
            [A-Za-z_]                 # Followed by letter or underscore
            [A-Za-z0-9_-]*            # Followed by letters, digits, underscores, hyphens
        captures:
          "1":
            name: punctuation.definition.entity.css
        name: entity.other.attribute-name.id.css

      # Class selector
      - match: |-
          (?x)
            (\.)                      # Group 1: Prefix (.)
            -?                        # Optional leading hyphen
            [A-Za-z_]                 # Followed by letter or underscore
            [A-Za-z0-9_-]*            # Followed by letters, digits, underscores, hyphens
        captures:
          "1":
            name: punctuation.definition.entity.css
        name: entity.other.attribute-name.class.css

      # Universal type selector (*)
      - match: "\\*"
        name: entity.name.tag.wildcard.css

      # Type selector (order is important here, it must come after ID and class selectors)
      - match: |-
          (?x)
            -?                        # Optional leading hyphen
            [A-Za-z_]                 # Followed by letter or underscore
            [A-Za-z0-9_-]*            # Followed by letters, digits, underscores, hyphens
        name: entity.name.tag.css

      # Attribute selector
      - match: |-
          (?x)
            (\[)                      # Group 1: Opening bracket ([)
            \s*                       # Optional whitespace after opening bracket
            (                         # Group 2: Attribute name
              -?                      #   Optional leading hyphen
              [A-Za-z_]               #   Followed by letter or underscore
              [A-Za-z0-9_-]*          #   Followed by letters, digits, underscores, hyphens
            )
            \s*                       # Optional whitespace after attribute name
            (?:                       # Optional operator + value + flag
              (                       #   Group 3: Operator (=, ~=, |=, ^=, $=, *=)
                [~|^$*]?              #     Optional operator prefix (~, |, ^, $, *)
                =                     #     Equal sign (=)
              )
              \s*                     #   Optional whitespace after operator
              (?:                     #   Attribute value
                (                     #     Group 4: double quoted value
                  (")                 #       Group 5: opening double quote
                  (?:\\.|""|[^"\\])*  #       Value is 0 or more non-double-quote characters, escaped characters or escaped double quotes ("")
                  (")                 #       Group 6: closing double quote
                )
                |(                    #     Group 7: single quoted value
                  (')                 #       Group 8: opening single quote
                  (?:\\.|[^'\\])*     #       Value is 0 or more non-single-quote characters or escaped characters
                  (')                 #       Group 9: closing single quote
                )
                |(                    #     Group 10: unquoted value
                  [^\]\s]+            #       Value is 1 or more non-whitespace, non-] characters
                )
              )
              \s*                     #   Optional whitespace after value
              ([is])?                 #   Group 11: optional flags i or s
            )?
            \s*                       # Optional whitespace after operator + value + flag
            (\])                      # Group 12: Closing bracket (])
        captures:
          "1":
            name: punctuation.definition.entity.begin.bracket.square.css
          "2":
            name: entity.other.attribute-name.css
          "3":
            name: keyword.operator.pattern.css
          "4":
            name: string.quoted.double.css
          "5":
            name: punctuation.definition.string.begin.css
          "6":
            name: punctuation.definition.string.end.css
          "7":
            name: string.quoted.single.css
          "8":
            name: punctuation.definition.string.begin.css
          "9":
            name: punctuation.definition.string.end.css
          "10":
            name: string.unquoted.attribute-value.css
          "11":
            name: keyword.other.flag.css
          "12":
            name: punctuation.definition.entity.end.bracket.square.css
        name: meta.attribute-selector.css

      # Pseudo-element selector with double colon (::)
      - match: |-
          (?x)
            (::)                      # Group 1: Prefix (::)
            (?:                       # Pseudo-element name
              -?                      #   Optional leading hyphen
              [A-Za-z_]               #   Followed by letter or underscore
              [A-Za-z0-9_-]*          #   Followed by letters, digits, underscores, hyphens
            )
        captures:
          "1":
            name: punctuation.definition.entity.css
        name: entity.other.attribute-name.pseudo-element.css

      # Pseudo-class selector and pseudo-element selector with single colon (:)
      - match: |-
          (?x)
            (:)                       # Group 1: Prefix (:)
            (?:                       # Pseudo-class or pseudo-element name
              -?                      #   Optional leading hyphen
              [A-Za-z_]               #   Followed by letter or underscore
              [A-Za-z0-9_-]*          #   Followed by letters, digits, underscores, hyphens
            )
            (?:                       # Optional function part
              (\()                    #   Group 2: Opening parenthesis
              (?:                     #   Function arguments
                (?:                   #     Double quoted value
                  \s*                 #       Optional whitespace after opening parenthesis
                  (                   #       Group 3: double quoted value
                    (")               #         Group 4: opening double quote
                    (?:\\.|[^"\\])*   #         Value is 0 or more non-double-quote characters or escaped characters
                    (")               #         Group 5: closing double quote
                  )
                  \s*                 #       Optional whitespace after double quoted value
                )
                |(?:                  #     Single quoted value
                  \s*                 #       Optional whitespace after opening parenthesis
                  (                   #       Group 6: single quoted value
                    (')               #         Group 7: opening single quote
                    (?:\\.|[^'\\])*   #         Value is 0 or more non-single-quote characters or escaped characters
                    (')               #         Group 8: closing single quote
                  )
                  \s*                 #       Optional whitespace after single quoted value
                )
                |(?:                  #     Regexp value
                  \s*                 #       Optional whitespace after opening parenthesis
                  (                   #       Group 9: regexp value
                    (\/)              #         Group 10: opening slash
                    (?:\\.|[^/\\])*   #         Value is 0 or more non-slash or escaped characters
                    (\/)              #         Group 11: closing slash
                    ([dgimsuy]*)      #         Group 12: optional flags
                  )
                  \s*                 #       Optional whitespace after regexp value
                )
                |(                    #     Group 13: unquoted value
                  (?:                 #       Nested parentheses allowed up to 3 levels
                    [^()]+            #       TODO: This can be improved to allow any level of nesting with recursion,
                    |                 #       but to do so, the whole selector logic would need to be rewritten with begin/end.
                    \(
                      (?:
                        [^()]+
                        |
                        \(
                          (?:
                            [^()]+
                            |
                            \(
                              [^()]+
                            \)
                          )*
                        \)
                      )*
                    \)
                  )*
                )
              )?
              (\))                    #   Group 14: Closing parenthesis
            )?
        captures:
          "1":
            name: punctuation.definition.entity.css
          "2":
            name: punctuation.section.function.begin.bracket.round.css
          "3":
            name: string.quoted.double.css
          "4":
            name: punctuation.definition.string.begin.css
          "5":
            name: punctuation.definition.string.end.css
          "6":
            name: string.quoted.single.css
          "7":
            name: punctuation.definition.string.begin.css
          "8":
            name: punctuation.definition.string.end.css
          "9":
            name: string.regexp.js
          "10":
            name: punctuation.definition.string.begin.js
          "11":
            name: punctuation.definition.string.end.js
          "12":
            name: keyword.other.regex
          "13":
            name: constant.numeric.css
          "14":
            name: punctuation.section.function.end.bracket.round.css
        name: entity.other.attribute-name.pseudo-class.css

      # Combinators (>, +, ~)
      - match: |-
          (?x)
            \s*                       # Optional leading whitespace
            ([>+~])                   # Group 1: Combinator character (>, +, ~)
            \s*                       # Optional trailing whitespace
        captures:
          "1":
            name: keyword.operator.combinator.css

      # Descendant combinator (whitespace)
      - match: |-
          (?x)
            (\s+)                     # Group 1: One or more whitespace characters
        captures:
          "1":
            name: keyword.operator.combinator.css

      # Grouping combinator (,)
      - match: |-
          (?x)
            \s*                       # Optional leading whitespace
            (\,)                      # Group 1: Combinator character (,)
            \s*                       # Optional trailing whitespace
        captures:
          "1":
            name: punctuation.separator.list.comma.css

      # Anything else is invalid
      - match: ".*"
        name: invalid.illegal.adblock

  domainListCommaSeparated:
    patterns:
      - match: "(~?)([^,]+)(,?)"
        captures:
          "1":
            name: keyword.other.adblock
          "2":
